# ===== Warframe Discord Bot Config =====

# Token ของบอท (จาก Discord Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=your-discord-bot-token-here

# ID ห้อง (channel) ที่จะส่งข้อความแจ้งเตือน
# วิธีดู: เปิด Developer Mode ใน Discord (Settings -> Advanced) แล้วคลิกขวาที่ห้อง -> Copy Channel ID
NOTIFY_CHANNEL_ID=123456789012345678

# แพลตฟอร์มเกม: pc, ps4, xb1, swi
PLATFORM=pc

# ความถี่ในการเช็ค API (นาที) - ค่าเริ่มต้น 5 นาที
CHECK_INTERVAL_MINUTES=5

# รางวัลที่สนใจ (แยกด้วยเครื่องหมาย , ) - บอทจะแจ้งเตือนเมื่อมี Alert ที่มีรางวัลเหล่านี้
# ค่าเริ่มต้น: Orokin Catalyst,Orokin Reactor,Forma
IMPORTANT_REWARDS=Orokin Catalyst,Orokin Reactor,Forma